<Window x:Class="RyzenBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyzenBoost — Optimizador para juegos"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        MinWidth="960" MinHeight="640"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Storyboard x:Key="FadeInUp">
            <DoubleAnimation Storyboard.TargetName="RootFade" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="RootTranslate" Storyboard.TargetProperty="Y"
                              From="18" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate"/>
        </Grid.RenderTransform>
        <Grid.Opacity>1</Grid.Opacity>
        <Grid x:Name="RootFade">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER: bienvenida con nombre real de Windows ===== -->
        <Border Grid.Row="0" Padding="28,22" Background="{StaticResource BgPanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="20" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sesión elevada (Administrador)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== TABS ===== -->
        <Border Grid.Row="1" Padding="24,14" Background="{StaticResource BgDarkBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabDashboard" Style="{StaticResource TabButton}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked" Tag="dashboard" Content="Panel"/>
                <RadioButton x:Name="TabOptim" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Tag="optim" Content="Optimización"/>
                <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Tag="settings" Content="Ajustes"/>
                <RadioButton x:Name="TabAbout" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Tag="about" Content="Acerca de"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENIDO (adaptable a resolución vía ScrollViewer + Viewbox de escala moderada) ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
            <Grid>

                <!-- PANEL: Dashboard -->
                <StackPanel x:Name="PanelDashboard" Visibility="Visible">
                    <UniformGrid Columns="3" Rows="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="CpuUsageText" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CpuNameText" Text="CPU detectada" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Margin="5,0,5,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="RAM" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="RamUsageText" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="RamTotalText" Text="—" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Margin="10,0,0,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="GPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="GpuUsageText" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="GpuNameShort" Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GpuSchedText" Text="HW Scheduling: —" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="ProfileTitleText" Text="Perfil Fortnite (Épico + Lumen)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ProfileSubtitleText" Text="Aplica de un clic: rendimiento máximo, GPU scheduling, Modo Juego y prioridad de proceso para el juego." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>
                            <Button x:Name="BtnApplyProfile" Content="Aplicar perfil ahora" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Click="BtnApplyProfile_Click"/>
                            <TextBlock x:Name="ProfileStatusText" Margin="0,12,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="LogList" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- PANEL: Optimizacion -->
                <StackPanel x:Name="PanelOptim" Visibility="Collapsed">
                    <TextBlock Text="Ejecutable objetivo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TargetProcessBox" Padding="10,8" Background="{StaticResource BgCardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Margin="0,0,0,20"/>

                    <StackPanel x:Name="OptionsStack"/>
                </StackPanel>

                <!-- PANEL: Ajustes -->
                <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sonido de interfaz" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Reproduce sonidos al iniciar, aplicar cambios y usar toggles." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox x:Name="SoundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="SoundToggle_Changed" Unchecked="SoundToggle_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Resolución detectada" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResolutionText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Liberar memoria automáticamente" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Reduce la RAM ocupada por la app cada 30 segundos sin pausar Windows." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="MemoryTrimToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="MemoryTrimToggle_Changed" Unchecked="MemoryTrimToggle_Changed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnRevertAll" Content="Revertir todos los cambios" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Click="BtnRevertAll_Click"/>
                </StackPanel>

                <!-- PANEL: Acerca de -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Qué hace realmente esta app" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" LineHeight="20">
                                RyzenBoost ajusta configuración estándar de Windows (plan de energía, GPU Hardware Scheduling, Modo de Juego, prioridad de proceso y servicios en segundo plano). 
                                No modifica el ejecutable del juego, no inyecta código y no interactúa con sistemas anti-trampas. 
                                Los ajustes reducen cuellos de botella del sistema operativo; no pueden superar los límites físicos del hardware.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ===== FOOTER ===== -->
        <Border Grid.Row="3" Padding="24,12" Background="{StaticResource BgPanelBrush}">
            <TextBlock Text="RyzenBoost v1.0 · Optimización general para Windows" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
        </Border>

        </Grid>
    </Grid>
</Window>
